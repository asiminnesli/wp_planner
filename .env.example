# ============================================================
#  WP Planner — Environment Variables
#  Kopyala: cp .env.example backend/.env
# ============================================================

# ── Database ─────────────────────────────────────────────────
# SQLite (local development)
DATABASE_URL=file:./data/dev.db

# ── JWT ──────────────────────────────────────────────────────
# En az 32 karakter, rastgele ve güçlü bir değer girin
JWT_SECRET=change-this-to-a-random-32-char-secret
JWT_EXPIRES_IN=7d

# ── Google Gemini AI ─────────────────────────────────────────
# Opsiyonel: global fallback API key
# Kullanıcılar web arayüzünden kendi API key'lerini girebilir
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────
# Frontend URL'si (production'da Render URL'ini girin)
FRONTEND_URL=http://localhost:5173

# ============================================================
#  RENDER.COM PRODUCTION DEĞERLERİ (render.yaml'da otomatik)
#  DATABASE_URL=file:/app/backend/data/prod.db
#  NODE_ENV=production
#  PORT=3000
#  JWT_SECRET=<render tarafından otomatik üretilir>
# ============================================================
